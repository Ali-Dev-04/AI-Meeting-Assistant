# ---------------------------------------------------------------------------
# AI Meeting Assistant — environment variables
# Copy to `.env` and fill in. NEVER commit real `.env` files.
# Grouped by component. Values shown are placeholders/examples.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API ---
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (with pgvector) ---
DATABASE_URL=postgresql://ama:ama@localhost:5432/ama?schema=public
# Direct (non-pooled) URL used by Prisma migrations
DIRECT_URL=postgresql://ama:ama@localhost:5432/ama?schema=public

# --- Redis (cache + BullMQ + refresh-token store) ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ama-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Speech-to-Text (self-hosted Whisper service) ---
STT_PROVIDER=whisper
STT_ENDPOINT=http://localhost:8080

# --- Embeddings (self-hosted sentence-transformer service) ---
EMBEDDING_PROVIDER=self-hosted
EMBEDDING_ENDPOINT=http://localhost:8081
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# --- Vector store ---
VECTOR_PROVIDER=pgvector

# --- Background jobs ---
BULLMQ_CONCURRENCY=4

# --- Email (transactional) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=AI Meeting Assistant <no-reply@example.com>

# --- Observability ---
SENTRY_DSN=
POSTHOG_KEY=
